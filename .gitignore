# Python/editor local state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.claude/

# Model weights and large reproducible media
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.mp4
*.avi
*.mov

# Local detection caches and generated score caches
behavior/cache/
experiments/fusion/scores/
experiments/*/det_cache/

# Runtime-only scheduler state (keep logs, metrics, config and reviews)
**/.queue*
**/.audit_queue*
**/.audit_lock
**/.queue_index
**/.queue_lock
**/*.pid
**/*.lock

# Local environment and credentials
.env
.env.*
!.env.example
