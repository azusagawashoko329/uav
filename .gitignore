# Python/editor local state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.claude/

# Model weights and large reproducible media
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.mp4
*.avi
*.mov
*.npy
**/visualizations/

# Local detection caches and generated score caches
behavior/cache/
**/det_cache/
*.pkl

# Runtime-only scheduler state (keep logs, metrics, config and reviews)
**/.queue*
**/.ablation_queue*
**/.audit_queue*
**/.audit_lock
**/.queue_index
**/.queue_lock
**/*.pid
**/*.lock

# Local environment and credentials
.env
.env.*
!.env.example

# External comparison repositories (provenance lives in comparison/**/record.json)
comparison/**/upstream/
experiments/**/results/uit_scores.csv
experiments/**/results/uit_matched_scores.csv
