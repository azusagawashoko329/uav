{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uav/comparison/record.schema.json",
  "title": "UAV-VAD comparison entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "dataset",
    "method",
    "method_display",
    "year",
    "variant",
    "status",
    "source",
    "protocol",
    "results",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(da|uit)-.+$"
    },
    "dataset": {
      "enum": ["da", "uit"]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "method_display": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1990,
      "maximum": 2100
    },
    "variant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$"
    },
    "status": {
      "enum": ["planned", "running", "completed", "failed", "cancelled", "blocked", "unknown"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "commit", "local_path", "experiment", "run_id", "license", "notes"],
      "properties": {
        "type": {
          "enum": ["internal", "external"]
        },
        "url": {
          "type": ["string", "null"]
        },
        "commit": {
          "type": ["string", "null"]
        },
        "local_path": {
          "type": ["string", "null"]
        },
        "experiment": {
          "type": ["string", "null"]
        },
        "run_id": {
          "type": ["string", "null"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "protocol": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["one_class", "train", "test", "metrics", "seed", "epochs", "input_size", "notes"],
      "properties": {
        "one_class": {
          "type": "boolean"
        },
        "train": {
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["AUC", "EER"]
          }
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "epochs": {
          "type": ["integer", "null"]
        },
        "input_size": {
          "type": ["integer", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["macro_auc", "macro_eer", "per_scene", "summary", "source_results"],
      "properties": {
        "macro_auc": {
          "type": ["number", "null"]
        },
        "macro_eer": {
          "type": ["number", "null"]
        },
        "per_scene": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["auc", "eer"],
            "properties": {
              "auc": {
                "type": "number"
              },
              "eer": {
                "type": "number"
              }
            }
          }
        },
        "summary": {
          "type": ["string", "null"]
        },
        "source_results": {
          "type": ["string", "null"]
        }
      }
    },
    "efficiency": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "status",
        "input_hwt",
        "code_commit",
        "weights_state",
        "da_adapted",
        "auc_source",
        "profiling_config",
        "inference_params_m",
        "training_trainable_params_m",
        "training_only_params_m",
        "frozen_inference_params_m",
        "flops_g_per_output_frame",
        "flops_window_g",
        "flops_verified",
        "flops_counter",
        "flops_ops_covered",
        "flops_ops_missing",
        "flops_common_subset_check",
        "flops_duplicate_check",
        "latency_bs1_p50_ms_per_output_frame",
        "latency_bs1_mean_ms_per_output_frame",
        "latency_bs1_p95_ms_per_output_frame",
        "fps_bs1",
        "fps_bs16",
        "input_frames_t",
        "effective_output_scores_k",
        "window_stride",
        "window_latency_ms",
        "fps_independent_window",
        "score_density",
        "frame_coverage",
        "fps_stream_estimated",
        "fps_stream_measured",
        "benchmark_source",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": ["measured", "partial/unverified", "paper-only", "blocked"]
        },
        "input_hwt": {
          "type": "string",
          "pattern": "^[0-9]+x[0-9]+x[0-9]+$"
        },
        "code_commit": {
          "type": ["string", "null"]
        },
        "weights_state": {
          "type": "string",
          "minLength": 1
        },
        "da_adapted": {
          "type": "boolean"
        },
        "auc_source": {
          "type": "string",
          "minLength": 1
        },
        "profiling_config": {
          "type": "string",
          "minLength": 1
        },
        "inference_params_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "training_trainable_params_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "training_only_params_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "frozen_inference_params_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "flops_g_per_output_frame": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "flops_window_g": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "flops_verified": {
          "type": "boolean"
        },
        "flops_counter": {
          "type": ["string", "null"]
        },
        "flops_ops_covered": {
          "type": "array",
          "items": {"type": "string"}
        },
        "flops_ops_missing": {
          "type": "array",
          "items": {"type": "string"}
        },
        "flops_common_subset_check": {
          "type": ["string", "null"]
        },
        "flops_duplicate_check": {
          "type": ["string", "null"]
        },
        "latency_bs1_p50_ms_per_output_frame": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "latency_bs1_mean_ms_per_output_frame": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "latency_bs1_p95_ms_per_output_frame": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "fps_bs1": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "fps_bs16": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "input_frames_t": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "effective_output_scores_k": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "window_stride": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "window_latency_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "fps_independent_window": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "score_density": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "frame_coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "fps_stream_estimated": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "fps_stream_measured": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "benchmark_source": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "protocol": {
            "type": "object"
          },
          "results": {
            "type": "object"
          }
        }
      }
    }
  ]
}
